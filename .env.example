# Copy to `.env.local` (git-ignored) for local development, and set the same
# variable in your host's environment — on Vercel: Project → Settings →
# Environment Variables.
#
# Without this the contact form in the Colophon's About tab is not rendered at
# all. See "Contact form" in README.md.
#
# This is a form id, not an address. It is public by design and gives nothing
# away; the address it forwards to lives with the form service and never
# reaches the browser. There is no `mailto:` option, on purpose.
VITE_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
